{
  "name": "craftbyte",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:dash": "pnpm --filter dashboard dev",
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "build:dash": "pnpm --filter dashboard build",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @craftbyte/db generate",
    "db:migrate": "pnpm --filter @craftbyte/db migrate",
    "db:seed": "pnpm --filter @craftbyte/db seed",
    "db:seed:demo": "pnpm --filter @craftbyte/db seed:demo"
  }
}
