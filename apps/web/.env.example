# Public site URL — used for canonical, Open Graph, sitemap, robots, JSON-LD.
# Set to your production domain on Vercel.
NEXT_PUBLIC_SITE_URL=https://callumc.id

# --- Database (shared with apps/dashboard) ---
# Dev: omit both — a local dev.db at the repo root is used automatically.
# Prod (Turso): libsql://<db-name>-<org>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- New-lead email (optional) ---
# Resend API key; leave empty to skip emails (local dev).
# Verify callumc.id in Resend first, or sending fails.
RESEND_API_KEY=
NOTIFY_FROM=Callum C Leads <leads@callumc.id>
DASHBOARD_URL=https://admin.callumc.id
