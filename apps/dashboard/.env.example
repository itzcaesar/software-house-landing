# --- Database (shared with apps/web) ---
# Dev: omit both — a local dev.db at the repo root is used automatically.
# Prod (Turso): libsql://<db-name>-<org>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Sessions ---
# Required in production. Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Prospect finder ---
# Google Cloud API key with "Places API (New)" enabled.
GOOGLE_MAPS_API_KEY=
